# Supabase project (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Postgres connection string (Connect → Session pooler), used only by `npm run db:migrate`
SUPABASE_DB_URL=
# Resend (https://resend.com) — staff login emails, customer invoices, daily report
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Dar Al-Aaliya Dates <no-reply@daraaliya.com>"
EMAIL_FROM=
# Random string used to protect the scheduled maintenance route (/api/cron/*)
CRON_SECRET=
# Public site URL (for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
